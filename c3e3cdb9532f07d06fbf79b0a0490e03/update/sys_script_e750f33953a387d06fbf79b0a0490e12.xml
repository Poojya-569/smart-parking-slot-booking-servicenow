        <script><![CDATA[(function executeRule(current, previous) {

    var newStatus = current.getValue('booking_status');
    var oldStatus = previous.getValue('booking_status');

    // When booking changes to Checked In
    if (newStatus == 'checked_in' &&
        oldStatus != 'checked_in' &&
        gs.nil(current.getValue('check_in_time'))) {

        var checkInTime = new GlideDateTime();
        current.setValue('check_in_time', checkInTime);
    }

    // When booking changes to Completed
    if (newStatus == 'completed' &&
        oldStatus != 'completed' &&
        gs.nil(current.getValue('check_out_time'))) {

        var checkOutTime = new GlideDateTime();
        current.setValue('check_out_time', checkOutTime);
    }

})(current, previous);]]></script>
