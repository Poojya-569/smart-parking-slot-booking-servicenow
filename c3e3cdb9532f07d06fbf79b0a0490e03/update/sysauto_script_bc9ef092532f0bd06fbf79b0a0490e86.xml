        <script><![CDATA[(function() {

    var now = new GlideDateTime();

    var booking = new GlideRecord(
        'x_1958892_smart_0_parking_booking'
    );

    booking.addQuery('booking_status', 'confirmed');
    booking.addQuery('end_time', '<', now.getValue());
    booking.query();

    while (booking.next()) {

        booking.setValue(
            'booking_status',
            'expired'
        );

        booking.update();
    }

})();]]></script>
